{
  "name": "sli-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SLI — AI Arabic Sign Language Interpreter: sign ↔ text ↔ speech, fully in the browser",
  "scripts": {
    "prepare-assets": "node scripts/copy-runtime.mjs",
    "dev": "npm run prepare-assets && vite",
    "build": "npm run prepare-assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "onnxruntime-node": "1.30.0",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
